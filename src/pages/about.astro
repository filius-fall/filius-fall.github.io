---
import TerminalText from '../components/TerminalText.astro';
import Layout from '../layouts/Layout.astro';
import { siteMeta } from '../lib/site.ts';
---

<Layout title="About" description={`About ${siteMeta.name}, a Python developer with a strong interest in systems, tools, and open source.`}>
  <div class="shell-container page-shell">
    <section class="hero-block hero-block--page">
      <p class="eyebrow">About</p>
      <TerminalText
        as="h1"
        text="Backend-focused engineer with a strong interest in systems, tooling, and clear technical writing."
        variant="section"
      />
      <p class="page-copy">Based in Bengaluru, India.</p>
    </section>

    <section class="content-section">
      <p class="page-copy">Main areas: Python services, developer tooling, protocols, and technical writing.</p>
    </section>

    <section class="content-section">
      <h2>How I work</h2>
      <ul class="plain-list">
        <li>Prefer simple systems that stay readable under change.</li>
        <li>Debug root causes instead of patching symptoms.</li>
        <li>Write to make technical decisions easier to understand.</li>
      </ul>
    </section>

    <section class="content-section">
      <h2>Technical interests</h2>
      <ul class="plain-list">
        <li>Python applications, APIs, and automation</li>
        <li>Networking, protocols, and system behavior</li>
        <li>Developer tools and open source</li>
      </ul>
    </section>

    <section class="content-section">
      <h2>Outside work</h2>
      <p class="page-copy">Reading manga, exploring new tools, and following implementation details.</p>
    </section>
  </div>
</Layout>
