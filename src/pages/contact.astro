---
import TerminalText from '../components/TerminalText.astro';
import Layout from '../layouts/Layout.astro';
import { socialLinks, siteMeta } from '../lib/site.ts';
---

<Layout title="Contact" description={`Get in touch with ${siteMeta.name}.`}>
  <div class="shell-container page-shell">
    <section class="hero-block hero-block--page">
      <TerminalText
        as="h1"
        text="Reach out if the work is relevant."
        variant="section"
      />
      <p class="page-copy">Best for backend engineering roles, tooling work, writing, and collaboration.</p>
    </section>

    <section class="content-section">
      <div class="text-list">
        {socialLinks.map((link) => (
          <article class="list-entry">
            <h2>{link.label}</h2>
            <p>{link.value}</p>
            <a href={link.href} class="archive-entry__link" target={link.href.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer">
              Open the channel
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="content-section">
      <h2>Good reasons to write</h2>
      <ul class="plain-list">
        <li>Backend engineering and practical Python work</li>
        <li>Developer tools and open source collaboration</li>
        <li>Systems, protocols, and technical writing</li>
      </ul>
    </section>
  </div>
</Layout>
