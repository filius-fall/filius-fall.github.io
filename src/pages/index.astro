---
import { getCollection } from 'astro:content';
import TerminalText from '../components/TerminalText.astro';
import Layout from '../layouts/Layout.astro';
import { capabilityCards, estimateReadingTime, formatDate, homepageSections, siteMeta, withBase } from '../lib/site.ts';

const posts = await getCollection('blog');
const recentPosts = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Layout title="Home" description={`${siteMeta.name} is a Python developer writing about systems, software, and open source.`}>
  <div class="shell-container page-shell">
    <section class="hero-block">
      <p class="eyebrow">Portfolio, writing, systems</p>
      <TerminalText
        as="h1"
        text={siteMeta.name}
        variant="hero"
        split="words"
      />
      <p class="hero-copy hero-copy--lead">{siteMeta.role}</p>
      <p class="hero-copy">{homepageSections.intro}</p>
      <div class="inline-links">
        <a href={withBase('/blog/')} class="button">Read the writing</a>
        <a href={withBase('/about/')} class="button button--ghost">About</a>
        <a href={withBase('/resume/')} class="button button--ghost">Resume</a>
      </div>
      <div class="meta-row">
        <span>{siteMeta.location}</span>
        <span>Available for practical engineering work</span>
        <span>GitHub: filius-fall</span>
      </div>
    </section>

    <section class="content-section">
      <div class="section-intro">
        <TerminalText as="h2" text="What I bring" variant="section" />
        <p>
          Backend reliability, tools that earn their keep, and writing that turns vague implementation talk into something concrete.
        </p>
      </div>

      <div class="simple-grid">
        {capabilityCards.map((card) => (
          <article class="simple-card">
            <h3>{card.title}</h3>
            <p>{card.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="content-section">
      <div class="section-intro">
        <TerminalText as="h2" text="Recent writing" variant="section" />
        <p>
          Protocols, streaming, transport, and the implementation details that decide whether systems stay calm or turn noisy.
        </p>
      </div>

      <div class="archive-list">
        {recentPosts.map((post) => (
          <article class="archive-entry">
            <div class="archive-entry__meta">
              <span>{formatDate(post.data.pubDate)}</span>
              <span>{estimateReadingTime(post.body)}</span>
              <span>{post.data.categories?.join(' / ')}</span>
            </div>
            <h3>{post.data.title}</h3>
            {post.data.description && <p>{post.data.description}</p>}
            <a href={withBase(`/blog/${post.id.replace('.md', '')}/`)} class="archive-entry__link">
              Read article
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="content-section content-section--compact">
      <div class="section-intro">
        <h2>Current focus</h2>
      </div>
      <ul class="plain-list">
        {homepageSections.currentFocus.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </section>
  </div>
</Layout>
