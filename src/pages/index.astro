---
import { getCollection } from 'astro:content';
import TerminalText from '../components/TerminalText.astro';
import Layout from '../layouts/Layout.astro';
import { capabilityCards, estimateReadingTime, formatDate, homepageSections, siteMeta, withBase } from '../lib/site.ts';

const posts = await getCollection('blog');
const recentPosts = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Layout title="Home" description={`${siteMeta.name} is a Python developer writing about systems, software, and open source.`}>
  <div class="shell-container page-shell">
    <section class="hero-block">
      <p class="eyebrow">Portfolio // Blog // Systems</p>
      <TerminalText
        as="h1"
        text={siteMeta.name}
        variant="hero"
        split="words"
      />
      <p class="hero-copy hero-copy--lead">{siteMeta.role}</p>
      <p class="hero-copy">{homepageSections.intro}</p>
      <div class="inline-links">
        <a href={withBase('/blog/')} class="button">Read the blog</a>
        <a href={withBase('/about/')} class="button">About</a>
        <a href={withBase('/resume/')} class="button">Resume</a>
      </div>
      <p class="meta-line">{siteMeta.location} / Available for practical engineering work / GitHub: filius-fall</p>
    </section>

    <section class="content-section">
      <TerminalText as="h2" text="What I bring" variant="section" />
      <div class="text-list">
        {capabilityCards.map((card) => (
          <article class="list-entry">
            <h3>{card.title}</h3>
            <p>{card.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="content-section">
      <TerminalText as="h2" text="Recent blog posts" variant="section" />
      <div class="archive-list">
        {recentPosts.map((post) => (
          <article class="archive-entry">
            <div class="archive-entry__meta">
              <span>{formatDate(post.data.pubDate)}</span>
              <span>{estimateReadingTime(post.body)}</span>
              <span>{post.data.categories?.join(' / ')}</span>
            </div>
            <h3>{post.data.title}</h3>
            {post.data.description && <p>{post.data.description}</p>}
            <a href={withBase(`/blog/${post.id.replace('.md', '')}/`)} class="archive-entry__link">
              Read article
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="content-section">
      <h2>Current focus</h2>
      <ul class="plain-list">
        {homepageSections.currentFocus.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </section>
  </div>
</Layout>
