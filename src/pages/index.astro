---
import { getCollection } from 'astro:content';
import avatar from '../../assets/img/avatar.jpg';
import PretextName from '../components/PretextName.astro';
import Layout from '../layouts/Layout.astro';
import { capabilityCards, homepageSections, siteMeta, withBase } from '../lib/site.ts';

const posts = await getCollection('blog');
const recentPosts = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Layout title="Home" description={`${siteMeta.name} is a Python developer writing about systems, software, and open source.`}>
  <div class="shell-container page-shell">
    <section class="hero">
      <div class="hero__content panel">
        <PretextName name={siteMeta.name} eyebrow="Portfolio, writing, and systems curiosity" />

        <p class="hero__lead">
          {siteMeta.role}
        </p>

        <p class="hero__lead">
          {homepageSections.intro}
        </p>

        <div class="hero__cta">
          <a href={withBase('/blog/')} class="button">Read the writing</a>
          <a href={withBase('/about/')} class="button button--secondary">About the work</a>
          <a href={withBase('/resume/')} class="button button--ghost">Open resume</a>
        </div>

        <div class="hero__meta">
          <span>{siteMeta.location}</span>
          <span>Open to practical engineering conversations</span>
          <span>GitHub: filius-fall</span>
        </div>
      </div>

      <aside class="hero__aside">
        <div class="hero__portrait panel">
          <img src={avatar.src} alt={`${siteMeta.name} portrait`} />
        </div>

        <div class="content-panel hero__card">
          <p class="eyebrow">Current focus</p>
          <ul class="focus-list">
            {homepageSections.currentFocus.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </aside>
    </section>

    <section class="section-stack">
      <div class="section-heading">
        <p class="eyebrow">What I bring</p>
        <h2>Practical engineering with a systems bias.</h2>
        <p>
          I like work that rewards clarity: robust backend code, sharp debugging, and writing that makes technical tradeoffs easier to see.
        </p>
      </div>

      <div class="capability-grid">
        {capabilityCards.map((card) => (
          <article class="capability-card">
            <h3>{card.title}</h3>
            <p>{card.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section-stack">
      <div class="section-heading">
        <p class="eyebrow">{homepageSections.recentWritingTitle}</p>
        <h2>Essays and technical notes from the edges of the stack.</h2>
        <p>
          Mostly networking, protocols, software architecture, and the details that change how systems actually behave.
        </p>
      </div>

      <div class="blog-grid">
        {recentPosts.map((post) => (
          <article class="blog-card">
            <div class="blog-card__meta">
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>
            </div>
            <h3>{post.data.title}</h3>
            {post.data.description && <p>{post.data.description}</p>}
            <div class="chip-row">
              {post.data.categories?.map((category) => (
                <span class="chip">{category}</span>
              ))}
            </div>
            <a href={withBase(`/blog/${post.id.replace('.md', '')}/`)} class="button button--ghost">
              Read article
            </a>
          </article>
        ))}
      </div>
    </section>
  </div>
</Layout>
