---
import TerminalText from '../../components/TerminalText.astro';
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { estimateReadingTime, formatDate, withBase } from '../../lib/site.ts';

export async function getStaticPaths() {
  const blog = await getCollection('blog');
  return blog.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout
  title={post.data.title}
  description={post.data.description || `Read ${post.data.title} on Sreeram Ambalam's blog.`}
>
  <div class="shell-container page-shell">
    <article class="article-shell">
      <header class="article-header">
        <a href={withBase('/blog/')} class="article-back">Back to blog</a>
        <div class="article-header__meta">
          <span>{formatDate(post.data.pubDate)}</span>
          <span>{estimateReadingTime(post.body)}</span>
          {post.data.categories?.map((category) => (
            <span>{category}</span>
          ))}
        </div>
        <TerminalText as="h1" text={post.data.title} variant="section" />
        {post.data.description && <p class="article-summary">{post.data.description}</p>}
      </header>

      <div class="prose">
        <Content />
      </div>
    </article>
  </div>
</Layout>
