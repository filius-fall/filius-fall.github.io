---
import TerminalText from '../../components/TerminalText.astro';
import TerminalWindow from '../../components/TerminalWindow.astro';
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { estimateReadingTime, formatDate, withBase } from '../../lib/site.ts';

export async function getStaticPaths() {
  const blog = await getCollection('blog');
  return blog.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
---

<Layout 
  title={post.data.title} 
  description={post.data.description || `Read ${post.data.title} on Sreeram Ambalam's blog.`}
>
  <div class="shell-container terminal-page">
    <div class="article-layout">
      <article class="article-shell">
        <TerminalWindow title="article-view" command={`open ${post.id}`}>
          <header class="article-header">
            <a href={withBase('/blog/')} class="article-back">cd .. / archive</a>
            <div class="article-header__meta">
              <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
              <span>{estimateReadingTime(post.body)}</span>
              {post.data.categories?.map((category) => (
                <span class="chip">{category}</span>
              ))}
            </div>
            <TerminalText as="h1" text={post.data.title} eyebrow="entry" variant="section" />
            {post.data.description && <p class="article-summary">{post.data.description}</p>}
          </header>

          <div class="prose">
            <Content />
          </div>
        </TerminalWindow>
      </article>

      {headings.length > 0 && (
        <aside class="article-sidebar">
          <TerminalWindow title="table-of-contents" command="ls headings" class="toc-shell">
            <nav class="toc-nav" aria-label="Table of contents">
              {headings
                .filter((heading) => heading.depth <= 3)
                .map((heading) => (
                  <a href={`#${heading.slug}`} class:list={['toc-nav__link', `depth-${heading.depth}`]}>
                    {heading.text}
                  </a>
                ))}
            </nav>
          </TerminalWindow>
        </aside>
      )}
    </div>
  </div>
</Layout>
