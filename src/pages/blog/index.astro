---
import { getCollection } from 'astro:content';
import TerminalText from '../../components/TerminalText.astro';
import Layout from '../../layouts/Layout.astro';
import { estimateReadingTime, formatDate, siteMeta, withBase } from '../../lib/site.ts';

const blog = await getCollection('blog');
const sortedBlog = blog.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Blog" description={`Technical writing and notes from ${siteMeta.name}.`}>
  <div class="shell-container page-shell">
    <section class="hero-block hero-block--page">
      <p class="eyebrow">Blog</p>
      <TerminalText
        as="h1"
        text="Notes on systems, protocols, and software behavior"
        variant="section"
      />
      <p class="page-copy">
        A simple archive of technical posts written to be useful first: clear enough for learning, technical enough to reward rereading.
      </p>
      <p class="meta-line">{sortedBlog.length} entries / Newest first / Systems / Protocols / Software</p>
    </section>

    <section class="content-section">
      <div class="archive-list">
        {sortedBlog.map((post) => (
          <article class="archive-entry">
            <div class="archive-entry__meta">
              <span>{formatDate(post.data.pubDate)}</span>
              <span>{estimateReadingTime(post.body)}</span>
              <span>{post.data.categories?.join(' / ')}</span>
            </div>
            <h2>{post.data.title}</h2>
            {post.data.description && <p>{post.data.description}</p>}
            <a href={withBase(`/blog/${post.id.replace('.md', '')}/`)} class="archive-entry__link">
              Read article
            </a>
          </article>
        ))}
      </div>
    </section>
  </div>
</Layout>
