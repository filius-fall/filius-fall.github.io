---
import TerminalText from '../components/TerminalText.astro';
import Layout from '../layouts/Layout.astro';
import { siteMeta, withBase } from '../lib/site.ts';
---

<Layout title="Resume" description={`${siteMeta.name}'s experience, strengths, and resume.`}>
  <div class="shell-container page-shell">
    <section class="hero-block hero-block--page">
      <p class="eyebrow">Resume</p>
      <TerminalText
        as="h1"
        text="Backend engineer focused on reliability, clarity, and systems thinking."
        variant="section"
      />
      <p class="page-copy">Python, APIs, automation, tooling, and technical writing.</p>
      <div class="inline-links">
        <a href={withBase(`/${siteMeta.resumeFile}`)} download class="button">
          Download PDF resume
        </a>
      </div>
    </section>

    <section class="content-section">
      <h2>Core capabilities</h2>
      <ul class="plain-list">
        <li>Python backend development and automation</li>
        <li>APIs, scripting, Git workflows, and Linux</li>
        <li>JavaScript and TypeScript for product and tooling work</li>
        <li>Technical writing for systems and backend topics</li>
      </ul>
    </section>

    <section class="content-section">
      <h2>What you can expect</h2>
      <ul class="plain-list">
        <li>Maintainable implementation</li>
        <li>Root-cause debugging</li>
        <li>Pragmatic decisions</li>
        <li>Clear communication</li>
      </ul>
    </section>

    <section class="content-section">
      <h2>Tools I reach for</h2>
      <p class="page-copy">Python / TypeScript / JavaScript / Astro / React / Linux / Git / REST APIs</p>
    </section>

    <section class="content-section">
      <h2>Reach me directly</h2>
      <ul class="plain-list">
        <li>{siteMeta.email}</li>
        <li>github.com/filius-fall</li>
        <li>@filius_fall</li>
        <li>{siteMeta.location}</li>
      </ul>
    </section>
  </div>
</Layout>
