---
interface Props {
  title: string;
  command?: string;
  class?: string;
}

const { title, command, class: className } = Astro.props;
---

<section class:list={['terminal-window', className]}>
  <div class="terminal-window__bar">
    <div class="terminal-window__lights" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </div>
    <p class="terminal-window__title">{title}</p>
    {command && <p class="terminal-window__command">{command}</p>}
  </div>
  <div class="terminal-window__body">
    <slot />
  </div>
</section>
