---
interface Props {
  name: string;
  eyebrow?: string;
}

const { name, eyebrow } = Astro.props;
---

<div class="pretext-name" data-pretext-name data-name={name}>
  {eyebrow && <p class="pretext-name__eyebrow">{eyebrow}</p>}
  <div class="pretext-name__canvas" data-pretext-canvas>
    <span class="pretext-name__fallback" data-pretext-fallback>{name}</span>
  </div>
</div>

<script>
  import { layoutWithLines, prepareWithSegments, walkLineRanges } from '../../node_modules/@chenglou/pretext/src/layout.ts';

  const roots = document.querySelectorAll('[data-pretext-name]');

  roots.forEach((root) => {
    if (!(root instanceof HTMLElement)) {
      return;
    }

    const canvas = root.querySelector('[data-pretext-canvas]');
    const fallback = root.querySelector('[data-pretext-fallback]');

    if (canvas instanceof HTMLElement && fallback instanceof HTMLElement) {
      const fullName = root.getAttribute('data-name') || '';
      const layoutName = fullName.trim().split(/\s+/).join('\n');
      let prepared = null;
      let lineHeight = 0;
      let lastSignature = '';
      let availableWidth = 0;

      const graphemeSegmenter = typeof Intl !== 'undefined' && 'Segmenter' in Intl
        ? new Intl.Segmenter(undefined, { granularity: 'grapheme' })
        : null;

      const splitGraphemes = (text) => {
        if (!text) return [];
        if (graphemeSegmenter) {
          return Array.from(graphemeSegmenter.segment(text), (entry) => entry.segment);
        }

        return Array.from(text);
      };

      const getFontDefinition = () => {
        const styles = window.getComputedStyle(fallback);
        const fontStyle = styles.fontStyle || 'normal';
        const fontWeight = styles.fontWeight || '700';
        const fontSize = styles.fontSize || '64px';
        const fontFamily = styles.fontFamily || '"Fraunces", serif';

        return {
          font: `${fontStyle} ${fontWeight} ${fontSize} ${fontFamily}`,
          lineHeight: parseFloat(styles.lineHeight) || parseFloat(fontSize) * 0.9,
        };
      };

      const drawLayout = (width) => {
        const count = walkLineRanges(prepared, width, () => {});
        const layoutWidth = count <= 2 ? width : availableWidth;
        const layout = layoutWithLines(prepared, layoutWidth, lineHeight);
        const signature = layout.lines.map((line) => line.text).join('|');

        if (signature === lastSignature) {
          return;
        }

        lastSignature = signature;
        canvas.innerHTML = '';

        let letterIndex = 0;

        layout.lines.forEach((line, index) => {
          const row = document.createElement('span');
          row.className = 'pretext-name__line';
          row.style.setProperty('--line-index', `${index}`);

          splitGraphemes(line.text).forEach((grapheme) => {
            const letter = document.createElement('span');
            letter.className = 'pretext-name__letter';
            letter.style.setProperty('--letter-index', `${letterIndex}`);
            letter.textContent = grapheme === ' ' ? '\u00A0' : grapheme;
            row.appendChild(letter);
            letterIndex += 1;
          });

          canvas.appendChild(row);
        });
      };

      const render = (force = false) => {
        const nextAvailableWidth = Math.max(Math.floor(root.clientWidth), 240);
        if (!force && Math.abs(nextAvailableWidth - availableWidth) < 4 && prepared) {
          return;
        }

        availableWidth = nextAvailableWidth;
        const fontDefinition = getFontDefinition();
        lineHeight = fontDefinition.lineHeight;
        prepared = prepareWithSegments(layoutName, fontDefinition.font, { whiteSpace: 'pre-wrap' });
        lastSignature = '';

        canvas.classList.remove('is-ready');
        canvas.style.width = 'auto';
        drawLayout(availableWidth);
        window.requestAnimationFrame(() => {
          canvas.classList.add('is-ready');
        });
      };

      const scheduleRender = () => {
        window.requestAnimationFrame(() => render());
      };

      const observer = new ResizeObserver(scheduleRender);
      observer.observe(root);

      if ('fonts' in document) {
        document.fonts.ready.then(() => render(true));
      } else {
        render(true);
      }

      window.addEventListener('pageshow', scheduleRender);
    }
  });
</script>
