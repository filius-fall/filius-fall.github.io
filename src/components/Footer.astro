---
import { siteMeta, socialLinks, withBase } from '../lib/site.ts';
---

<footer class="site-footer">
  <div class="shell-container">
    <div class="site-footer__inner">
      <div class="site-footer__intro">
        <p class="site-footer__eyebrow">About this site</p>
        <h2>{siteMeta.name}</h2>
        <p>
          Personal site for notes on engineering, systems, and the work of making software feel deliberate.
        </p>
      </div>

      <div class="site-footer__links">
        <div>
          <p class="site-footer__label">Pages</p>
          <a href={withBase('/about/')}>About</a>
          <a href={withBase('/blog/')}>Writing</a>
          <a href={withBase('/resume/')}>Resume</a>
        </div>
        <div>
          <p class="site-footer__label">Elsewhere</p>
          {socialLinks.map((link) => (
            <a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer">
              {link.label}
            </a>
          ))}
        </div>
      </div>

      <div class="site-footer__meta">
        <p class="site-footer__label">Contact</p>
        <p>Location: {siteMeta.location}</p>
        <p>{siteMeta.email}</p>
        <a class="button button--ghost" href={`mailto:${siteMeta.email}`}>
          Say hello
        </a>
        <p>© 2026 {siteMeta.name}.</p>
      </div>
    </div>
  </div>
</footer>
