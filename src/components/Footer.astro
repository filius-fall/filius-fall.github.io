---
import TerminalText from './TerminalText.astro';
import { siteMeta, socialLinks, withBase } from '../lib/site.ts';
---

<footer class="site-footer">
  <div class="shell-container">
    <div class="site-footer__inner">
      <div class="site-footer__intro">
        <TerminalText
          as="h2"
          text={siteMeta.name}
          eyebrow="session summary"
          variant="label"
          compact
        />
        <p>
          Personal site for notes on engineering, systems, and the work of making software feel deliberate.
        </p>
      </div>

      <div class="site-footer__links">
        <div>
          <p class="site-footer__label">routes</p>
          <a href={withBase('/about/')}>about</a>
          <a href={withBase('/blog/')}>writing</a>
          <a href={withBase('/resume/')}>resume</a>
        </div>
        <div>
          <p class="site-footer__label">signals</p>
          {socialLinks.map((link) => (
            <a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer">
              {link.label}
            </a>
          ))}
        </div>
      </div>

      <div class="site-footer__meta">
        <p class="site-footer__label">status</p>
        <p>Location: {siteMeta.location}</p>
        <p>Build target: GitHub Pages</p>
        <a class="button button--ghost" href={`mailto:${siteMeta.email}`}>
          start conversation
        </a>
        <p>
          © 2026 {siteMeta.name}. static, dark, and still blinking.
        </p>
      </div>
    </div>
  </div>
</footer>
